variable players = list.create()
list.add(players, "Steve")
list.add(players, "Alex")

for each player in list.sort(players) {
    print(text.upper(player))
}

variable scoreboard = {"Steve": 10, "Alex": 20}
map.set(scoreboard, "Alex", 25)
print(scoreboard["Alex"])
print(text.format("Jogadores: {count}", {"count": list.length(players)}))

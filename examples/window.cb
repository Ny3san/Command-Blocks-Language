permissao janela

janela.abrir("Command Blocks", 420, 240)
variavel nome = janela.entrada("Steve", 20, 20, 240, 28)
variavel saudacao = janela.rotulo("Digite seu nome", 20, 60, 340, 28)
variavel botao = janela.botao("Cumprimentar", "cumprimentar", 20, 100, 160, 32)

evento cumprimentar {
    janela.definir_texto(saudacao, "Olá, " + janela.texto(nome))
}

janela.executar()

permission window

window.open("Command Blocks", 420, 240)
variable name = window.input("Steve", 20, 20, 240, 28)
variable greeting = window.label("Digite seu nome", 20, 60, 340, 28)
variable button = window.button("Cumprimentar", "greet", 20, 100, 160, 32)

event greet {
    window.set_text(greeting, "Olá, " + window.text(name))
}

window.run()

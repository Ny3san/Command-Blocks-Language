{
  "Variable": {
    "prefix": "var",
    "body": [
      "variable ${1:name} = ${2:value}"
    ],
    "description": "Declares a variable"
  },
  "Constant": {
    "prefix": "const",
    "body": [
      "constant ${1:NAME} = ${2:value}"
    ],
    "description": "Declares a constant"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "function ${1:name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "Declares a function"
  },
  "Event": {
    "prefix": "event",
    "body": [
      "event ${1:start} {",
      "\t$0",
      "}"
    ],
    "description": "Declares an event"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Conditional block"
  },
  "Repeat": {
    "prefix": "rep",
    "body": [
      "repeat ${1:3} times {",
      "\t$0",
      "}"
    ],
    "description": "Repeats a block"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Loop while a condition holds"
  },
  "Test": {
    "prefix": "test",
    "body": [
      "test \"${1:name}\" {",
      "\tassert(${2:condition})",
      "}"
    ],
    "description": "Declares a test"
  },
  "Import": {
    "prefix": "imp",
    "body": [
      "import ${1:library}"
    ],
    "description": "Imports an optional library"
  },
  "Permission": {
    "prefix": "perm",
    "body": [
      "permission ${1:file}"
    ],
    "description": "Declares a permission"
  }
}
